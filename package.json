{
  "name": "n8n-nodes-hubspot-advanced",
  "version": "0.1.0",
  "description": "Advanced HubSpot nodes for n8n with rate limiting, batch operations, and association hydration",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "homepage": "https://viminds.de",
  "author": {
    "name": "viminds GmbH",
    "email": "support@viminds.de"
  },
  "bugs": {
    "email": "support@viminds.de"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && npm run copy:icons",
    "copy:icons": "copyfiles -u 1 \"src/**/*.{png,svg}\" dist/ && copyfiles \"icon.svg\" dist/",
    "dev": "tsc --watch",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build && npm run lint && npm run test"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/HubSpotCrm/HubSpotCrm.node.js",
      "dist/nodes/HubSpotAssociations/HubSpotAssociations.node.js",
      "dist/nodes/HubSpotForms/HubSpotForms.node.js",
      "dist/nodes/HubSpotObjectSchema/HubSpotObjectSchema.node.js",
      "dist/nodes/HubSpotLists/HubSpotLists.node.js"
    ]
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.19",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "copyfiles": "^2.4.1",
    "eslint": "^8.56.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "jest": "^29.7.0",
    "nock": "^13.5.1",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "n8n-workflow": "^1.29.0",
    "n8n-core": "^1.29.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "dependencies": {},
  "engines": {
    "node": ">=18.17.0"
  }
}
