#!/bin/bash

set -e

echo "🔨 Building project..."
npm run build

echo "🔗 Linking package..."
npm link
mkdir -p ~/.n8n/nodes && cd ~/.n8n/nodes
npm init -y 2>/dev/null || true
npm link n8n-nodes-hubspot-advanced
cd -

echo "⚠️  Stopping n8n if running..."
pkill -f "n8n" || true
sleep 2

echo "▶️  Executing workflow t3Awq9e0UAZbVzPb..."
n8n execute --id t3Awq9e0UAZbVzPb 2>&1 | tee /tmp/n8n_test.log

if [ ${PIPESTATUS[0]} -eq 0 ]; then
    echo ""
    echo "✅ Workflow executed successfully"
    echo "📝 Full log available at: /tmp/n8n_test.log"
else
    echo ""
    echo "❌ Workflow failed"
    echo "📝 Error log saved to: /tmp/n8n_test.log"
    echo ""
    echo "🔍 Last 20 lines of error:"
    tail -n 20 /tmp/n8n_test.log
    exit 1
fi
